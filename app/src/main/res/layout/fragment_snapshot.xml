<?xml version="1.0" encoding="utf-8"?>
<com.absinthe.libchecker.view.app.CustomViewFlipper xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:app="http://schemas.android.com/apk/res-auto"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@+id/vf_container"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  tools:context=".domain.snapshot.list.ui.SnapshotFragment">

  <com.absinthe.libchecker.view.app.DotLoadingView
    android:id="@+id/loading"
    android:layout_width="match_parent"
    android:layout_height="match_parent" />

  <rikka.widget.borderview.BorderRecyclerView
    android:id="@android:id/list"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:scrollbars="none"
    app:borderBottomVisibility="never"
    app:borderTopDrawable="@null"
    app:borderTopVisibility="whenTop" />

</com.absinthe.libchecker.view.app.CustomViewFlipper>
