{
  dependencyDashboard: true,
  labels: [
    'dependencies',
  ],
  extends: [
    'config:recommended',
  ],
  packageRules: [
    {
      groupName: 'Kotlin, KSP and MoshiX',
      matchPackageNames: [
        'com.google.devtools.ksp{/,}**',
        'dev.zacsweers.moshix{/,}**',
        '/org.jetbrains.kotlin.*/',
      ],
    },
    {
      groupName: 'AndroidX',
      matchPackageNames: [
        '/^androidx\\./',
      ],
    },
    {
      // Filter-only aliases must match resolved transitive versions; review rules before updating.
      matchPackageNames: [
        'androidx.coordinatorlayout:coordinatorlayout',
        'com.google.android.gms:play-services-basement',
      ],
      enabled: false,
    },
  ],
}
